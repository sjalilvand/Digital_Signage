# نمونه تنظیمات محیطی — این فایل را به .env کپی و مقادیر را تغییر دهید:
#   cp .env.example .env

# --- عمومی -----------------------------------------------------------------
# کلید رمزنگاری Django (تولید: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=please-change-this-to-a-long-random-string
DEBUG=0
# دامنه/آی‌پی سرور، جدا با کاما (برای CORS وقتی DEBUG=0)
ALLOWED_HOSTS=*

# --- دیتابیس ---------------------------------------------------------------
POSTGRES_DB=signage
POSTGRES_USER=signage
POSTGRES_PASSWORD=change-me-strong-password

# --- کاربر پیش‌فرض پنل (فقط بار اول ساخته می‌شود) ---------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.local

# --- محدودیت‌ها -------------------------------------------------------------
# حداکثر حجم آپلود هر فایل (گیگابایت) — هماهنگ با nginx client_max_body_size
MAX_UPLOAD_GB=2

# --- گیت‌وی -----------------------------------------------------------------
# پورت ورودی سرور (پنل + API) روی شبکه ساختمان
GATEWAY_PORT=8080
